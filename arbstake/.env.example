# Environment Variables Template
# Copy this file to .env and fill in your actual values

# WalletConnect Project ID
# Get yours from: https://cloud.walletconnect.com/
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# BSC Testnet Contract Addresses
VITE_BSC_STAKING_CONTRACT=0x0000000000000000000000000000000000000000
VITE_BSC_REFERRAL_CONTRACT=0x0000000000000000000000000000000000000000
VITE_BSC_TOKEN_CONTRACT=0x0000000000000000000000000000000000000000

# Base Sepolia Contract Addresses
VITE_BASE_STAKING_CONTRACT=0x0000000000000000000000000000000000000000
VITE_BASE_REFERRAL_CONTRACT=0x0000000000000000000000000000000000000000
VITE_BASE_TOKEN_CONTRACT=0x0000000000000000000000000000000000000000

# Application Settings
VITE_APP_URL=https://staryield.com
VITE_SUPPORT_EMAIL=support@staryield.com
